# Local defaults work without this file. Generate a private key for production.
SECRET_KEY=local-development-only-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated HTTPS origins, required for the deployed host.
CSRF_TRUSTED_ORIGINS=
# Leave unset for SQLite. Never commit a real connection string.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Public demo autofill exposes these credentials. Use only disposable demo data.
DEMO_MODE=False
DEMO_ADMIN_PASSWORD=LocalAdmin20!
DEMO_STAFF_PASSWORD=LocalStaff20!
DEMO_STUDENT_PASSWORD=LocalStudent20!
# Disable uploads on ephemeral hosts unless using object storage.
PHOTO_UPLOADS=True
USE_S3=False
# Required only when USE_S3=True. Use a publicly readable demo-media bucket.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# Public bucket domain (e.g. a Cloudflare R2 "pub-...r2.dev" subdomain) so uploaded
# media URLs are plain HTTPS links instead of expiring signed ones.
AWS_S3_CUSTOM_DOMAIN=
# Production only. Enable proxy trust only behind a trusted HTTPS proxy.
SECURE_SSL_REDIRECT=True
TRUST_PROXY_HEADERS=False
# Lecturer demo account password (seed_demo resets it on every run)
DEMO_LECTURER_PASSWORD=LocalLecturer20!
# Pin the academic session (e.g. 2025/2026); leave empty to derive from today's date
CURRENT_SESSION=
# Institution name shown on transcripts and headers
INSTITUTION_NAME=Student Management System
# Optional email settings: enables self-service password reset.
# Leave EMAIL_HOST empty to hide the forgot-password link (console backend in dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@studentrecords.local
